# ============================================
# Configuración de Facturación CAMS (Diverza)
# ============================================
# Copia este archivo como ".env" y rellena los valores
# con los datos fiscales REALES del cliente.
# Cada build (.exe) embebe su propio .env.

# Identificación fiscal
FACTURACION_RFC=TU_RFC_AQUI
FACTURACION_NOMBRE=TU_RAZON_SOCIAL
FACTURACION_CP=00000

# Régimen Fiscal SAT
#   601 - General de Ley Personas Morales
#   612 - Personas Físicas con Actividades Empresariales
FACTURACION_REGIMEN=601

# Uso del CFDI
#   G03 - Gastos en general
#   G01 - Adquisición de mercancías
FACTURACION_USO_CFDI=G03

# Correo receptor de las facturas
FACTURACION_EMAIL=tu-correo@ejemplo.com